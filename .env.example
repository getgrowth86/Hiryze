# ── Funnel-Links (public) ─────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_LINK=https://chat.whatsapp.com/PLACEHOLDER
NEXT_PUBLIC_CHECKOUT_PLAYBOOK=https://buy.stripe.com/PLACEHOLDER_PLAYBOOK
NEXT_PUBLIC_CHECKOUT_SESSION=https://buy.stripe.com/PLACEHOLDER_SESSION
NEXT_PUBLIC_EVERWEBINAR_EMBED=https://everwebinar.com/PLACEHOLDER

# ── ActiveCampaign ────────────────────────────────────────────
NEXT_PUBLIC_MAKE_WEBHOOK_URL=https://hook.eu2.make.com/PLACEHOLDER

# ── Meta Pixel ────────────────────────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://hiryze.de

# ── Mission Control (server only, set in Vercel, never commit values)
# Required for the password gate. Set on Production and Preview.
DASHBOARD_PASSWORD=

# Read-only Google service account JSON, one line. Used for the lead sheet and GA4.
# Sheet: viewer on the Webinar-Leads spreadsheet.
# GA4: role Betrachter on the property named by GA4_PROPERTY_ID.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional overrides. Defaults: the known Webinar-Leads sheet and tab.
LEADS_SHEET_ID=
LEADS_SHEET_TAB=

# Numeric GA4 property id for the Data API. Not the measurement id.
GA4_PROPERTY_ID=

# Ignore sheet rows before this Berlin date (YYYY-MM-DD). Optional.
COUNT_FROM=

CALENDLY_TOKEN=
STRIPE_SECRET_KEY=
NOTION_TOKEN=
NOTION_DATABASE_ID=
